{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "airbc.user_calibration_data/1",
  "title": "AIRBC user calibration data contract, version 1",
  "description": "Structural contract for one donor or one declared group. The executable preflight is apps/api/services/user_data_contract.py; it also enforces cross-field rules this schema cannot express (strictly increasing times, series length equal to the number of time points, initial-state time equal to the first time point, no duplicated pool/compartment). A dataset that satisfies this contract is not thereby runnable: engine compatibility is reported separately and is currently false.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "dataset", "time", "geometry", "initial_state", "channels"],
  "properties": {
    "schema_version": {"const": "airbc.user_calibration_data/1"},
    "dataset": {
      "type": "object",
      "required": ["dataset_id", "cohort_id", "subject"],
      "not": {"anyOf": [{"required": ["subjects"]}, {"required": ["donors"]}]},
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "cohort_id": {"type": "string", "minLength": 1},
        "subject": {
          "type": "object",
          "required": ["kind", "id"],
          "properties": {
            "kind": {"enum": ["donor", "declared_group"]},
            "id": {"type": "string", "minLength": 1},
            "group_definition": {
              "type": "object",
              "required": ["description", "pooling_method", "n_subjects"],
              "properties": {
                "description": {"type": "string", "minLength": 1},
                "pooling_method": {"type": "string", "minLength": 1},
                "n_subjects": {"type": "integer", "minimum": 1}
              }
            }
          },
          "if": {"properties": {"kind": {"const": "declared_group"}}},
          "then": {"required": ["group_definition"]}
        }
      }
    },
    "time": {
      "type": "object",
      "required": ["unit", "origin", "points"],
      "properties": {
        "unit": {"enum": ["day"]},
        "origin": {
          "type": "object",
          "required": ["kind", "description"],
          "properties": {
            "kind": {"enum": ["collection", "storage_start", "first_sample", "other"]},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "points": {"type": "array", "minItems": 1, "items": {"type": "number"}}
      }
    },
    "geometry": {
      "type": "object",
      "required": ["hematocrit", "provenance"],
      "properties": {
        "hematocrit": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "provenance": {
          "type": "object",
          "required": ["kind", "source"],
          "properties": {
            "kind": {"enum": ["measured_this_dataset", "measured_other_source", "borrowed", "assumed"]},
            "source": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "initial_state": {
      "type": "object",
      "required": ["policy", "time", "unmeasured_pools_policy"],
      "properties": {
        "policy": {"enum": ["user_measured_at_first_time", "user_declared_table"]},
        "time": {"type": "number"},
        "unmeasured_pools_policy": {"enum": ["declared_latent_contract", "undeclared"]},
        "latent_contract": {"type": "string"},
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "compartment", "unit", "value", "source"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "compartment": {"enum": ["intracellular", "extracellular"]},
              "unit": {"enum": ["mM", "uM", "nM"]},
              "value": {"type": "number", "minimum": 0},
              "source": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "if": {"properties": {"policy": {"const": "user_declared_table"}}},
      "then": {"required": ["values"]}
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "compartment", "kind", "unit", "values"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "compartment": {"enum": ["intracellular", "extracellular"]},
          "kind": {"enum": ["absolute", "relative"]},
          "unit": {"type": "string"},
          "values": {"type": "array", "items": {"type": ["number", "null"], "minimum": 0}},
          "normalization": {
            "type": "object",
            "required": ["basis", "description"],
            "properties": {
              "basis": {"enum": ["first_point", "internal_standard", "total_signal", "other"]},
              "description": {"type": "string", "minLength": 1}
            }
          },
          "anchor": {
            "type": "object",
            "required": ["value", "unit", "time", "source"],
            "properties": {
              "value": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"enum": ["mM", "uM", "nM"]},
              "time": {"type": "number"},
              "source": {"type": "string", "minLength": 1}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "absolute"}}},
            "then": {
              "properties": {"unit": {"enum": ["mM", "uM", "nM"]}},
              "not": {"anyOf": [{"required": ["anchor"]}, {"required": ["normalization"]}]}
            }
          },
          {
            "if": {"properties": {"kind": {"const": "relative"}}},
            "then": {
              "properties": {"unit": {"enum": ["relative", "fold_change", "peak_area", "arbitrary"]}},
              "required": ["normalization"]
            }
          }
        ]
      }
    }
  }
}
