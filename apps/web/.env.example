# Public Supabase configuration for the Next.js web app.
# Set these in Vercel for the web project and in your local apps/web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
INTERNAL_WEB_API_BASE_URL=http://127.0.0.1:3000/api
SCIENCE_API_BASE_URL=https://api.airbc.org/api
MONITORING_API_BASE_URL=https://monitoring-api.airbc.org/api
RESEARCH_API_BASE_URL=https://research-api.airbc.org/api
CALIBRATION_API_BASE_URL=http://127.0.0.1:8010
CALIBRATION_API_SHARED_SECRET=replace_with_a_long_random_secret
